# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Set the same variables in Vercel (Project Settings -> Environment Variables).

# Public client configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side only secrets (do NOT prefix with NEXT_PUBLIC_)
MONGO_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Badges (optional)
# Your sign-in email(s), comma separated. These accounts get the Owner badge. Never shown to others.
OWNER_EMAILS=
# Push notifications (optional). Create keys once with: npx web-push generate-vapid-keys
# The public key is safe for browsers; the private key must stay server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
