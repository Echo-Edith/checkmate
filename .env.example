# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Set the same variables in Vercel (Project Settings -> Environment Variables).

# Public client configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side only secrets (do NOT prefix with NEXT_PUBLIC_)
MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
